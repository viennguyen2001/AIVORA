{% if section.settings.text != blank %}
  <div class="announcement" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
    {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif %}{{ section.settings.text }}{% if section.settings.link != blank %}</a>{% endif %}
  </div>
{% endif %}
{% schema %}
{"name":"t:sections.announcement.name","settings":[{"type":"text","id":"text","label":"t:labels.text","default":"Free shipping on orders over $150"},{"type":"url","id":"link","label":"t:labels.link"}],"presets":[{"name":"t:sections.announcement.name"}]}
{% endschema %}
