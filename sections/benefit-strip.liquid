<section class="benefit-strip page-width">
  {% for block in section.blocks %}<div {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div>{% endfor %}
</section>
{% stylesheet %}
.benefit-strip{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--color-line)}.benefit-strip>div{padding:25px 22px;border-right:1px solid var(--color-line)}.benefit-strip>div:last-child{border-right:0}.benefit-strip strong,.benefit-strip span{display:block}.benefit-strip span{color:var(--color-muted);font-size:var(--text-sm);margin-top:4px}@media(max-width:749px){.benefit-strip{grid-template-columns:1fr 1fr}.benefit-strip>div:nth-child(2){border-right:0}.benefit-strip>div:nth-child(-n+2){border-bottom:1px solid var(--color-line)}}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.benefits.name","blocks":[{"type":"benefit","name":"t:sections.benefits.benefit","settings":[{"type":"text","id":"title","label":"t:labels.heading","default":"Camera in every pair"},{"type":"text","id":"text","label":"t:labels.text","default":"Hands stay free"}]}],"max_blocks":4,"presets":[{"name":"t:sections.benefits.name","blocks":[{"type":"benefit"},{"type":"benefit","settings":{"title":"12-month warranty","text":"Covers the electronics"}},{"type":"benefit","settings":{"title":"30-day returns","text":"Easy, tracked returns"}},{"type":"benefit","settings":{"title":"Fast dispatch","text":"Ships in 1–3 days"}}]}]}
{% endschema %}
