<section class="paths section">
  <div class="page-width">
    <div class="paths__head"><div><div class="eyebrow muted">{{ section.settings.eyebrow }}</div><h2 class="section-heading">{{ section.settings.heading }}</h2></div><p>{{ section.settings.text }}</p></div>
    <div class="paths__grid">
      {% for block in section.blocks %}
        <a class="path-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          <div class="path-card__media">
            {% if block.settings.image %}{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 800, 1200', sizes: '(max-width:749px) 86vw, 42vw', alt: block.settings.heading }}{% else %}<img src="{{ block.settings.fallback | append: '.jpg' | asset_url }}" alt="{{ block.settings.heading | escape }}" width="1200" height="900" loading="lazy">{% endif %}
          </div>
          <div class="path-card__body"><span class="eyebrow">{{ block.settings.kicker }}</span><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p><ul>{% if block.settings.feature_1 != blank %}<li>{{ block.settings.feature_1 }}</li>{% endif %}{% if block.settings.feature_2 != blank %}<li>{{ block.settings.feature_2 }}</li>{% endif %}</ul><span class="text-link">{{ block.settings.cta }} &rarr;</span></div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% stylesheet %}
.paths__head{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:end;margin-bottom:38px}.paths__head .eyebrow{margin-bottom:12px}.paths__head p{color:var(--color-muted);max-width:52ch;margin:0}.paths__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}.path-card{min-width:0;background:var(--color-surface);border-radius:var(--radius-card);overflow:hidden;text-decoration:none}.path-card__media{aspect-ratio:16/10;overflow:hidden}.path-card__media img{width:100%;height:100%;object-fit:cover;transition:transform .5s var(--ease-out)}.path-card:hover img{transform:scale(1.025)}.path-card__body{padding:28px}.path-card h3{font-size:2rem;margin:10px 0}.path-card p{color:var(--color-muted);max-width:48ch}.path-card ul{padding-left:18px;color:var(--color-muted)}.path-card .text-link{margin-top:16px}.path-card:nth-child(3){grid-column:span 2}.path-card:nth-child(3){display:grid;grid-template-columns:1.3fr 1fr}.path-card:nth-child(3) .path-card__media{aspect-ratio:auto}
@media(max-width:749px){.paths__head{grid-template-columns:1fr;gap:16px}.paths__grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;margin-inline:-16px;padding-inline:16px}.path-card,.path-card:nth-child(3){flex:0 0 86%;display:block;scroll-snap-align:start}.path-card__body{padding:22px}.path-card h3{font-size:1.6rem}}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.paths.name","settings":[{"type":"text","id":"eyebrow","label":"t:labels.eyebrow","default":"Start here"},{"type":"text","id":"heading","label":"t:labels.heading","default":"Which pair are you after?"},{"type":"textarea","id":"text","label":"t:labels.text","default":"Everyday frames, cycling eyewear and camera-ready gear. Pick the one that matches what you do."}],"blocks":[{"type":"category","name":"t:sections.paths.category","settings":[{"type":"image_picker","id":"image","label":"t:labels.image"},{"type":"select","id":"fallback","label":"t:sections.paths.fallback","options":[{"value":"category-cycling","label":"Cycling"},{"value":"category-ski","label":"Ski"},{"value":"category-aqua","label":"Aqua"},{"value":"category-moto","label":"Moto"}],"default":"category-cycling"},{"type":"text","id":"kicker","label":"t:labels.eyebrow","default":"14 frames"},{"type":"text","id":"heading","label":"t:labels.heading","default":"Everyday"},{"type":"textarea","id":"text","label":"t:labels.text","default":"For the commute, the trip and the table."},{"type":"text","id":"feature_1","label":"t:sections.paths.feature_1","default":"Open-ear audio"},{"type":"text","id":"feature_2","label":"t:sections.paths.feature_2","default":"Hands-free capture"},{"type":"text","id":"cta","label":"t:labels.button_label","default":"Shop category"},{"type":"url","id":"link","label":"t:labels.link"}]}],"max_blocks":6,"presets":[{"name":"t:sections.paths.name","blocks":[{"type":"category"},{"type":"category","settings":{"fallback":"category-cycling","kicker":"5 frames","heading":"Cycling","text":"For the ride, the run and the climb.","feature_1":"Polarised UV400","feature_2":"Wraparound fit"}},{"type":"category","settings":{"fallback":"category-ski","kicker":"2 goggles","heading":"Ski & Snow","text":"Record the mountain from your own point of view.","feature_1":"Anti-fog lens","feature_2":"One-button recording"}}]}]}
{% endschema %}
