<section class="faq section">
  <div class="page-width faq__grid">
    <div><div class="eyebrow muted">{{ section.settings.eyebrow }}</div><h2 class="section-heading">{{ section.settings.heading }}</h2></div>
    <div>
      <div class="faq__items">{% for block in section.blocks %}<details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.question }}<span>+</span></summary><div class="rte muted">{{ block.settings.answer }}</div></details>{% endfor %}</div>
      {% if section.settings.show_contact %}<div class="faq__contact"><h3>{{ section.settings.contact_heading }}</h3><p class="muted">{{ section.settings.contact_text }}</p>{% form 'contact' %}{{ form.errors | default_errors }}<div class="faq__fields"><input type="text" name="contact[name]" autocomplete="name" placeholder="{{ 'templates.contact.form.name' | t }}"><input type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'templates.contact.form.email' | t }}"></div><textarea rows="4" name="contact[body]" placeholder="{{ 'templates.contact.form.comment' | t }}"></textarea><button class="button" type="submit">{{ 'templates.contact.form.send' | t }}</button>{% endform %}</div>{% endif %}
    </div>
  </div>
</section>
{% stylesheet %}
.faq__grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:8%}.faq h2{margin-top:12px}.faq__items{border-top:1px solid var(--color-line)}.faq details{border-bottom:1px solid var(--color-line)}.faq summary{list-style:none;display:flex;justify-content:space-between;gap:20px;padding:22px 0;font-weight:600}.faq summary::-webkit-details-marker{display:none}.faq summary span{font-size:1.5rem;transition:transform .2s}.faq details[open] summary span{transform:rotate(45deg)}.faq details .rte{padding-bottom:24px}.faq__contact{margin-top:54px;padding:28px;background:var(--color-surface);border-radius:var(--radius-card)}.faq__fields{display:grid;grid-template-columns:1fr 1fr;gap:10px}.faq input,.faq textarea{width:100%;border:1px solid var(--color-line);background:var(--color-canvas);border-radius:var(--radius-control);padding:13px 14px;margin-bottom:10px}.faq textarea{resize:vertical}.faq__contact h3{font-size:1.6rem;margin-bottom:8px}@media(max-width:749px){.faq__grid{grid-template-columns:1fr;gap:28px}.faq__fields{grid-template-columns:1fr}}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.faq.name","settings":[{"type":"text","id":"eyebrow","label":"t:labels.eyebrow","default":"Need to know"},{"type":"text","id":"heading","label":"t:labels.heading","default":"Frequently asked questions"},{"type":"checkbox","id":"show_contact","label":"t:sections.faq.show_contact","default":true},{"type":"text","id":"contact_heading","label":"t:sections.faq.contact_heading","default":"Didn't find your answer?"},{"type":"text","id":"contact_text","label":"t:sections.faq.contact_text","default":"Send us a message and we will usually reply within a day."}],"blocks":[{"type":"question","name":"t:sections.faq.question","settings":[{"type":"text","id":"question","label":"t:sections.faq.question_label","default":"What is the difference between the ranges?"},{"type":"richtext","id":"answer","label":"t:sections.faq.answer","default":"<p>The technology is similar; the frame, lens and intended activity are what change.</p>"}]}],"presets":[{"name":"t:sections.faq.name","blocks":[{"type":"question"},{"type":"question","settings":{"question":"Will people know when I am recording?","answer":"<p>Yes. A visible indicator light comes on while the camera is running.</p>"}},{"type":"question","settings":{"question":"Are they safe in rain?","answer":"<p>Check the IP rating on each product page before use in wet conditions.</p>"}}]}]}
{% endschema %}
