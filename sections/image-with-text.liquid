<section class="media-story section">
  <div class="page-width media-story__grid{% if section.settings.layout == 'text_first' %} media-story__grid--reverse{% endif %}">
    <div class="media-story__media">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(max-width:749px) 100vw, 55vw', alt: section.settings.heading }}{% else %}<img src="{{ 'editorial-assistant.jpg' | asset_url }}" width="1200" height="1200" loading="lazy" alt="{{ section.settings.heading | escape }}">{% endif %}</div>
    <div class="media-story__copy"><div class="eyebrow muted">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2><div class="rte muted">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="text-link" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} &rarr;</a>{% endif %}</div>
  </div>
</section>
{% stylesheet %}
.media-story__grid{display:grid;grid-template-columns:1.15fr .85fr;gap:6%;align-items:center}.media-story__grid--reverse .media-story__media{order:2}.media-story__media{border-radius:var(--radius-card);overflow:hidden;background:var(--color-surface);aspect-ratio:5/4}.media-story__media img{width:100%;height:100%;object-fit:cover}.media-story__copy h2{font-size:clamp(2.5rem,4.8vw,5rem);margin:14px 0 24px;max-width:10ch}.media-story__copy .text-link{margin-top:28px}@media(max-width:749px){.media-story__grid{grid-template-columns:1fr;gap:30px}.media-story__grid--reverse .media-story__media{order:0}.media-story__copy h2{font-size:2.7rem}}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.image_text.name","settings":[{"type":"image_picker","id":"image","label":"t:labels.image"},{"type":"select","id":"layout","label":"t:labels.layout","options":[{"value":"image_first","label":"t:options.image_first"},{"value":"text_first","label":"t:options.text_first"}],"default":"image_first"},{"type":"text","id":"eyebrow","label":"t:labels.eyebrow","default":"Hands-free"},{"type":"text","id":"heading","label":"t:labels.heading","default":"Say “Hey, Turbo”"},{"type":"richtext","id":"text","label":"t:labels.text","default":"<p>Directional microphones pull your voice out of the noise. Ask a question, start a recording or take a call without reaching for anything.</p>"},{"type":"text","id":"button_label","label":"t:labels.button_label","default":"What the assistant can do"},{"type":"url","id":"button_link","label":"t:labels.button_link"}],"presets":[{"name":"t:sections.image_text.name"}]}
{% endschema %}
