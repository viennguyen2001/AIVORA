<section class="section cart-page"><div class="page-width"><h1 class="section-heading">{{ 'templates.cart.cart' | t }}</h1>{% if cart.empty? %}<p class="muted">{{ 'sections.cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>{% else %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-lines">{% for item in cart.items %}<div class="cart-line"><a href="{{ item.url }}">{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}</a><div><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a><div class="muted">{{ item.variant.title }}</div><a href="{{ item.url_to_remove }}">{{ 'sections.cart.remove_title' | t: title: item.title }}</a></div><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.product.quantity.label' | t }}"><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}</div><div class="cart-total"><span>{{ 'sections.cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div><div class="cart-actions"><button class="button button--secondary" type="submit" name="update">{{ 'sections.cart.update' | t }}</button><button class="button" type="submit" name="checkout">{{ 'sections.cart.checkout' | t }}</button></div></form>{% endif %}</div></section>
{% stylesheet %}.cart-page h1{margin-bottom:40px}.cart-lines{border-top:1px solid var(--color-line)}.cart-line{display:grid;grid-template-columns:120px 1fr auto auto;gap:22px;align-items:center;padding:20px 0;border-bottom:1px solid var(--color-line)}.cart-line img{width:120px;aspect-ratio:1;object-fit:contain;background:var(--color-surface);border-radius:12px}.cart-line input{width:72px;padding:10px;border:1px solid var(--color-line);border-radius:999px}.cart-total,.cart-actions{display:flex;justify-content:flex-end;gap:28px;margin-top:24px}.cart-actions{gap:10px}@media(max-width:749px){.cart-line{grid-template-columns:84px 1fr}.cart-line img{width:84px}.cart-line>input,.cart-line>strong{grid-column:2}.cart-actions{flex-direction:column}}{% endstylesheet %}
{% schema %}{"name":"t:sections.main_cart.name","settings":[]}{% endschema %}
