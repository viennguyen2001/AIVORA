<section class="main-product section" id="Product-{{ section.id }}" data-product-section>
  <div class="page-width main-product__grid main-product__grid--{{ section.settings.gallery_width }}">
    {% render 'product-media-gallery', product: product, media_fit: section.settings.media_fit, enable_zoom: section.settings.enable_zoom %}
    <div class="product-summary">
      {% form 'product', product, id: 'ProductForm-' | append: section.id, class: 'product-form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>
        {% for block in section.blocks %}
          <div class="product-block product-block--{{ block.type }}" {{ block.shopify_attributes }}>
            {% case block.type %}
              {% when '@app' %}{% render block %}
              {% when 'vendor' %}<div class="eyebrow muted">{{ product.vendor }}</div>
              {% when 'title' %}<h1>{{ product.title }}</h1>
              {% when 'rating' %}{% assign rating = product.metafields.reviews.rating.value %}{% if rating != blank %}<a class="product-rating" href="#ProductReviews-{{ section.id }}" aria-label="{{ 'products.product.rating_info' | t: rating: rating.rating, scale: rating.scale_max }}"><span aria-hidden="true">★★★★★</span><strong>{{ rating.rating | round: 1 }}</strong>{% if product.metafields.reviews.rating_count %}<span class="muted">({{ product.metafields.reviews.rating_count }})</span>{% endif %}</a>{% elsif request.design_mode %}<div class="product-rating"><span aria-hidden="true">★★★★★</span><span class="muted">{{ 'products.product.no_reviews' | t }}</span></div>{% endif %}
              {% when 'price' %}{% render 'product-price', product: product, show_tax_notice: block.settings.show_tax_notice %}
              {% when 'sku' %}<p class="product-sku muted" data-sku>{{ 'products.product.sku' | t }}: {{ product.selected_or_first_available_variant.sku | default: '—' }}</p>
              {% when 'short_description' %}<div class="rte muted">{% if block.settings.text != blank %}{{ block.settings.text }}{% else %}<p>{{ product.description | strip_html | truncatewords: block.settings.words }}</p>{% endif %}</div>
              {% when 'variant_picker' %}{% render 'product-variant-picker', product: product, section_id: section.id, picker_type: block.settings.picker_type %}
              {% when 'inventory' %}<div class="inventory-status" data-inventory data-low-threshold="{{ block.settings.low_threshold }}"><span></span><strong data-inventory-label>{% if product.selected_or_first_available_variant.available %}{{ 'products.product.in_stock' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</strong>{% if block.settings.show_quantity and product.selected_or_first_available_variant.inventory_management %}<span data-inventory-count>{{ 'products.product.units_left' | t: count: product.selected_or_first_available_variant.inventory_quantity }}</span>{% endif %}</div>
              {% when 'quantity' %}<div class="quantity-control"><label for="Quantity-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label><div><button type="button" data-quantity-minus aria-label="{{ 'products.product.quantity.decrease' | t }}">−</button><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="{{ product.selected_or_first_available_variant.quantity_rule.min | default: 1 }}" step="{{ product.selected_or_first_available_variant.quantity_rule.increment | default: 1 }}" value="{{ product.selected_or_first_available_variant.quantity_rule.min | default: 1 }}"><button type="button" data-quantity-plus aria-label="{{ 'products.product.quantity.increase' | t }}">+</button></div></div>
              {% when 'buy_buttons' %}{% render 'product-buy-buttons', product: product, show_dynamic_checkout: block.settings.show_dynamic_checkout, form: form %}
              {% when 'icon_list' %}<div class="product-icon-list">{% for i in (1..3) %}{% capture text_key %}text_{{ i }}{% endcapture %}{% capture subtext_key %}subtext_{{ i }}{% endcapture %}{% if block.settings[text_key] != blank %}<div><span class="product-icon-list__mark" aria-hidden="true">✓</span><p><strong>{{ block.settings[text_key] }}</strong>{% if block.settings[subtext_key] != blank %}<small>{{ block.settings[subtext_key] }}</small>{% endif %}</p></div>{% endif %}{% endfor %}</div>
              {% when 'collapsible_tab' %}<details class="product-accordion" {% if block.settings.open_by_default %}open{% endif %}><summary>{{ block.settings.heading }}<span>+</span></summary><div class="rte muted">{{ block.settings.content }}{{ block.settings.page.content }}</div></details>
              {% when 'share' %}<div class="product-share"><span>{{ block.settings.label }}</span><button type="button" data-copy-url>{{ 'products.product.copy_link' | t }}</button></div>
              {% when 'custom_liquid' %}{{ block.settings.custom_liquid }}
              {% when 'divider' %}<hr>
              {% when 'spacer' %}<div style="height:{{ block.settings.space }}px"></div>
            {% endcase %}
          </div>
        {% endfor %}
      {% endform %}
    </div>
  </div>
  <script type="application/json" data-product-variants>[{% for variant in product.variants %}{"id":{{ variant.id | json }},"available":{{ variant.available | json }},"option1":{{ variant.option1 | json }},"option2":{{ variant.option2 | json }},"option3":{{ variant.option3 | json }},"price":{{ variant.price | money | json }},"compareAt":{{ variant.compare_at_price | money | json }},"onSale":{% if variant.compare_at_price > variant.price %}true{% else %}false{% endif %},"sku":{{ variant.sku | json }},"inventory":{{ variant.inventory_quantity | json }},"inventoryManaged":{{ variant.inventory_management | json }},"featuredMediaId":{{ variant.featured_media.id | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]</script>
</section>
{% stylesheet %}
.main-product{padding-top:38px}.main-product__grid{display:grid;gap:5%;align-items:start}.main-product__grid--large{grid-template-columns:minmax(0,1.25fr) minmax(360px,.75fr)}.main-product__grid--medium{grid-template-columns:minmax(0,1fr) minmax(400px,1fr)}.product-summary{position:sticky;top:22px;padding:10px 0}.product-form{display:flex;flex-direction:column}.product-block{margin-bottom:18px}.product-block--vendor+.product-block--title{margin-top:-9px}.product-block--divider{margin-block:4px}.product-block h1{font-size:clamp(2.5rem,4vw,4.6rem);margin:0}.product-price{display:flex;align-items:center;gap:12px;font-size:1.45rem;font-weight:650}.product-price s{color:var(--color-muted);font-size:1rem}.product-price__badge{font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;padding:5px 8px;background:var(--color-accent);color:var(--color-on-accent);border-radius:999px}.product-tax{font-size:.78rem;margin:5px 0 0}.product-rating{display:inline-flex;gap:9px;align-items:center;text-decoration:none;font-size:.84rem}.product-rating>span:first-child{letter-spacing:.08em;color:var(--color-accent)}.product-sku{font-size:.8rem;margin:0}.variant-picker__group{border:0;padding:0;margin:0 0 18px}.variant-picker__group legend{font-size:.82rem;margin-bottom:9px}.variant-picker__values{display:flex;flex-wrap:wrap;gap:8px}.variant-picker__values input{position:absolute;opacity:0;pointer-events:none}.variant-picker__values span{display:block;padding:10px 15px;border:1px solid var(--color-line);border-radius:999px;font-size:.84rem;cursor:pointer}.variant-picker__values input:checked+span{background:var(--color-ink);color:var(--color-canvas);border-color:var(--color-ink)}.variant-picker__values input:disabled+span{text-decoration:line-through;opacity:.38;cursor:not-allowed}.variant-picker select{width:100%;padding:13px;border:1px solid var(--color-line);border-radius:var(--radius-control);background:var(--color-canvas)}.inventory-status{display:flex;align-items:center;gap:8px;font-size:.82rem}.inventory-status>span:first-child{width:8px;height:8px;border-radius:50%;background:#2f8f58;box-shadow:0 0 0 4px #2f8f5817}.inventory-status.is-low>span:first-child{background:#d28b27}.inventory-status.is-out>span:first-child{background:#c84b45}.quantity-control{display:flex;justify-content:space-between;align-items:center}.quantity-control label{font-size:.82rem;font-weight:600}.quantity-control>div{display:grid;grid-template-columns:38px 46px 38px;border:1px solid var(--color-line);border-radius:999px;overflow:hidden}.quantity-control button,.quantity-control input{height:42px;border:0;background:transparent;text-align:center}.quantity-control input{width:46px;-moz-appearance:textfield}.quantity-control input::-webkit-inner-spin-button{appearance:none}.product-buy__submit{width:100%;min-height:56px}.product-buy .shopify-payment-button{margin-top:10px}.product-icon-list{display:grid;gap:11px;padding:18px;background:var(--color-surface);border-radius:var(--radius-card)}.product-icon-list>div{display:flex;gap:11px;align-items:flex-start}.product-icon-list__mark{width:22px;height:22px;border-radius:50%;background:var(--color-ink);color:#fff;display:grid;place-items:center;font-size:.7rem;flex:0 0 auto}.product-icon-list p{margin:0;font-size:.83rem}.product-icon-list small{display:block;color:var(--color-muted);margin-top:2px}.product-accordion{border-top:1px solid var(--color-line)}.product-accordion:last-child{border-bottom:1px solid var(--color-line)}.product-accordion summary{display:flex;justify-content:space-between;padding:17px 0;list-style:none;font-weight:600}.product-accordion summary::-webkit-details-marker{display:none}.product-accordion summary span{font-size:1.3rem}.product-accordion[open] summary span{transform:rotate(45deg)}.product-accordion .rte{padding-bottom:18px;font-size:.9rem}.product-share{display:flex;justify-content:space-between;font-size:.82rem}.product-share button{border:0;background:none;text-decoration:underline;text-underline-offset:4px}.product-block hr{border:0;border-top:1px solid var(--color-line)}
.product-media__stage{position:relative;aspect-ratio:1;background:var(--color-surface);border-radius:var(--radius-card);overflow:hidden}.product-media__item{position:absolute;inset:0;opacity:0;pointer-events:none;transition:opacity .25s}.product-media__item.is-active{opacity:1;pointer-events:auto}.product-media__item>*{width:100%;height:100%}.product-media__item img,.product-media__item video,.product-media__item model-viewer{width:100%;height:100%;object-fit:var(--media-fit)}.product-media__image{padding:0;border:0;background:transparent}.product-media__image--zoom{cursor:zoom-in}.product-media__counter{position:absolute;right:16px;bottom:16px;padding:7px 11px;border-radius:999px;background:#fff;color:#171717;font-size:.75rem}.product-media__thumbs{display:flex;gap:9px;overflow-x:auto;padding-top:10px}.product-media__thumb{flex:0 0 76px;width:76px;height:76px;padding:0;border:1px solid transparent;border-radius:10px;background:var(--color-surface);overflow:hidden}.product-media__thumb.is-active{border-color:var(--color-ink)}.product-media__thumb img{width:100%;height:100%;object-fit:contain}.product-media__dialog{width:min(94vw,1200px);height:min(92vh,1000px);border:0;padding:40px;background:#fff}.product-media__dialog::backdrop{background:rgba(0,0,0,.82)}.product-media__dialog img{width:100%;height:100%;object-fit:contain}.product-media__dialog button{position:absolute;right:10px;top:6px;border:0;background:none;font-size:2rem}@media(max-width:989px){.main-product__grid,.main-product__grid--large,.main-product__grid--medium{grid-template-columns:1fr}.product-summary{position:static}.product-media__stage{margin-inline:-16px;border-radius:0}.product-media__thumbs{margin-inline:-16px;padding-inline:16px}.product-block h1{font-size:2.8rem}}
{% endstylesheet %}
{% javascript %}
(() => { document.querySelectorAll('[data-product-section]').forEach((root) => { if(root.dataset.ready)return; root.dataset.ready='true'; const variants=JSON.parse(root.querySelector('[data-product-variants]').textContent||'[]'); const idInput=root.querySelector('[data-variant-id]'); const groups=[...root.querySelectorAll('[data-option-position]')]; const selectVariant=()=>{const chosen=groups.map(group=>group.querySelector(':checked')?.value||group.querySelector('select')?.value||'');const variant=variants.find(item=>[item.option1,item.option2,item.option3].slice(0,chosen.length).every((value,index)=>value===chosen[index]));if(!variant)return;idInput.value=variant.id;const price=root.querySelector('[data-price]');if(price)price.textContent=variant.price;const compare=root.querySelector('[data-compare-price]');if(compare){compare.textContent=variant.compareAt;compare.hidden=!variant.onSale}const badge=root.querySelector('[data-sale-badge]');if(badge)badge.hidden=!variant.onSale;const sku=root.querySelector('[data-sku]');if(sku)sku.textContent=`SKU: ${variant.sku||'—'}`;const add=root.querySelector('[data-add-to-cart]');if(add){add.disabled=!variant.available;add.querySelector('[data-add-label]').textContent=variant.available?add.dataset.availableLabel:add.dataset.soldLabel}const inventory=root.querySelector('[data-inventory]');if(inventory){inventory.classList.toggle('is-out',!variant.available);inventory.classList.toggle('is-low',variant.available&&variant.inventoryManaged&&variant.inventory<=Number(inventory.dataset.lowThreshold))}if(variant.featuredMediaId)root.querySelector(`[data-media-thumb="${variant.featuredMediaId}"]`)?.click();history.replaceState({},'',`${location.pathname}?variant=${variant.id}`)}; root.addEventListener('change',event=>{if(event.target.matches('.variant-picker input,.variant-picker select')){const group=event.target.closest('[data-option-position]');const label=group?.querySelector('[data-selected-option]');if(label)label.textContent=event.target.value;selectVariant()}}); root.querySelector('[data-quantity-minus]')?.addEventListener('click',()=>root.querySelector('[name="quantity"]').stepDown());root.querySelector('[data-quantity-plus]')?.addEventListener('click',()=>root.querySelector('[name="quantity"]').stepUp());const activateMedia=id=>{root.querySelectorAll('[data-media-id]').forEach(item=>item.classList.toggle('is-active',item.dataset.mediaId===id));root.querySelectorAll('[data-media-thumb]').forEach(item=>item.classList.toggle('is-active',item.dataset.mediaThumb===id));const active=root.querySelector(`[data-media-id="${id}"]`),counter=root.querySelector('[data-media-current]');if(active&&counter)counter.textContent=Number(active.dataset.mediaIndex)+1};root.querySelectorAll('[data-media-thumb]').forEach(thumb=>thumb.addEventListener('click',()=>activateMedia(thumb.dataset.mediaThumb)));root.querySelectorAll('[data-media-zoom]').forEach(button=>button.addEventListener('click',()=>{const dialog=root.querySelector('[data-media-dialog]'),image=dialog.querySelector('img');image.src=button.querySelector('img').currentSrc;image.alt=button.querySelector('img').alt;dialog.showModal()}));root.querySelector('[data-media-dialog-close]')?.addEventListener('click',()=>root.querySelector('[data-media-dialog]').close());root.querySelector('[data-copy-url]')?.addEventListener('click',async event=>{await navigator.clipboard.writeText(location.href);event.currentTarget.textContent='Copied'}) }); })();
{% endjavascript %}
