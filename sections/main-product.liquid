<section class="main-product section">
  <div class="page-width main-product__grid">
    <div class="product-gallery">
      {% for media in product.media %}<div class="product-gallery__item">{{ media.preview_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(max-width: 749px) 100vw, 58vw', alt: media.alt }}</div>{% else %}<div class="product-gallery__item">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>{% endfor %}
    </div>
    <div class="product-summary">
      {% if section.settings.eyebrow != blank %}<div class="eyebrow muted">{{ section.settings.eyebrow }}</div>{% endif %}
      <h1>{{ product.title }}</h1>
      <div class="product-summary__price">{{ product.selected_or_first_available_variant.price | money }}{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}<s>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>{% endif %}</div>
      <div class="rte muted"><p>{{ product.description | strip_html | truncatewords: 55 }}</p></div>
      {% form 'product', product %}
        {% unless product.has_only_default_variant %}<label for="Variant-{{ section.id }}">{{ 'products.product.choose_options' | t }}</label><select id="Variant-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}
        <div class="product-summary__purchase"><input type="number" name="quantity" min="1" value="1" aria-label="{{ 'products.product.quantity.label' | t }}"><button class="button" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button></div>
        {% if section.settings.show_dynamic_checkout %}{{ form | payment_button }}{% endif %}
      {% endform %}
      <div class="product-summary__assurances">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div>{% endfor %}</div>
    </div>
  </div>
</section>
{% stylesheet %}
.main-product__grid{display:grid;grid-template-columns:1.15fr .85fr;gap:5%;align-items:start}.product-gallery{display:grid;grid-template-columns:1fr 1fr;gap:12px}.product-gallery__item{aspect-ratio:1;background:var(--color-surface);border-radius:var(--radius-card);overflow:hidden}.product-gallery__item:first-child{grid-column:span 2}.product-gallery__item img,.product-gallery__item svg{width:100%;height:100%;object-fit:contain}.product-summary{position:sticky;top:24px;padding:20px 0}.product-summary h1{font-size:clamp(2.4rem,4vw,4.3rem);margin:12px 0 20px}.product-summary__price{font-size:1.35rem;font-weight:600;margin-bottom:22px}.product-summary__price s{color:var(--color-muted);margin-left:10px}.product-summary form{margin-top:28px}.product-summary label{display:block;font-size:.85rem;font-weight:600;margin-bottom:7px}.product-summary select{width:100%;padding:14px;border:1px solid var(--color-line);border-radius:var(--radius-control);background:var(--color-canvas);margin-bottom:12px}.product-summary__purchase{display:flex;gap:10px}.product-summary__purchase input{width:72px;border:1px solid var(--color-line);border-radius:999px;text-align:center}.product-summary__purchase .button{flex:1}.product-summary__assurances{margin-top:30px;border-top:1px solid var(--color-line)}.product-summary__assurances>div{display:flex;justify-content:space-between;gap:20px;padding:14px 0;border-bottom:1px solid var(--color-line);font-size:.85rem}.product-summary__assurances span{color:var(--color-muted);text-align:right}@media(max-width:749px){.main-product__grid{grid-template-columns:1fr}.product-gallery{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;margin-inline:-16px;padding-inline:16px}.product-gallery__item,.product-gallery__item:first-child{flex:0 0 88%;scroll-snap-align:center}.product-summary{position:static}.product-summary h1{font-size:2.6rem}}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.main_product.name","settings":[{"type":"text","id":"eyebrow","label":"t:labels.eyebrow","default":"Smart eyewear"},{"type":"checkbox","id":"show_dynamic_checkout","label":"t:sections.main_product.dynamic_checkout","default":false}],"blocks":[{"type":"assurance","name":"t:sections.main_product.assurance","settings":[{"type":"text","id":"title","label":"t:labels.heading","default":"Free shipping"},{"type":"text","id":"text","label":"t:labels.text","default":"On orders over $150"}]}]}
{% endschema %}
