<section class="product-comparison section">
  <div class="page-width"><header class="product-section-head"><div><div class="eyebrow muted">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2></div><p class="muted">{{ section.settings.text }}</p></header><div class="product-comparison__scroll"><table><thead><tr><th>{{ section.settings.feature_label }}</th><th>{{ section.settings.primary_label }}</th><th>{{ section.settings.secondary_label }}</th></tr></thead><tbody>{% for block in section.blocks %}<tr {{ block.shopify_attributes }}><th>{{ block.settings.feature }}</th><td>{{ block.settings.primary }}</td><td>{{ block.settings.secondary }}</td></tr>{% endfor %}</tbody></table></div></div>
</section>
{% stylesheet %}
.product-comparison__scroll{overflow-x:auto}.product-comparison table{width:100%;min-width:680px;border-collapse:collapse}.product-comparison th,.product-comparison td{text-align:left;padding:18px 20px;border-bottom:1px solid var(--color-line)}.product-comparison thead th{font-size:.75rem;letter-spacing:.12em;text-transform:uppercase}.product-comparison th:nth-child(2),.product-comparison td:nth-child(2){background:var(--color-surface)}.product-comparison tbody th{font-weight:500;color:var(--color-muted)}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.product_comparison.name","settings":[{"type":"text","id":"eyebrow","label":"t:labels.eyebrow","default":"Compare"},{"type":"text","id":"heading","label":"t:labels.heading","default":"Choose the right frame"},{"type":"textarea","id":"text","label":"t:labels.text","default":"The electronics may be similar. The fit and lens are where the experience changes."},{"type":"text","id":"feature_label","label":"t:sections.product_comparison.feature_label","default":"Feature"},{"type":"text","id":"primary_label","label":"t:sections.product_comparison.primary_label","default":"Everyday"},{"type":"text","id":"secondary_label","label":"t:sections.product_comparison.secondary_label","default":"Sport"}],"blocks":[{"type":"row","name":"t:sections.product_comparison.row","settings":[{"type":"text","id":"feature","label":"t:labels.feature","default":"Best for"},{"type":"text","id":"primary","label":"t:sections.product_comparison.primary_value","default":"Commute and travel"},{"type":"text","id":"secondary","label":"t:sections.product_comparison.secondary_value","default":"Ride, run and climb"}]}],"max_blocks":12,"presets":[{"name":"t:sections.product_comparison.name","blocks":[{"type":"row"},{"type":"row","settings":{"feature":"Lens","primary":"Clear or photochromic","secondary":"Polarised UV400"}},{"type":"row","settings":{"feature":"Fit","primary":"Lightweight everyday","secondary":"Wraparound active"}}]}]}
{% endschema %}
