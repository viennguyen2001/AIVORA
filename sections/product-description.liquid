<section class="product-description section"><div class="page-width product-description__grid"><div><div class="eyebrow muted">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2></div><div class="rte product-description__content">{{ product.description }}</div></div></section>
{% stylesheet %}.product-description__grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:8%}.product-description h2{font-size:clamp(2.5rem,5vw,5.2rem);max-width:8ch;margin:12px 0}.product-description__content{font-size:1.05rem}.product-description__content h2,.product-description__content h3{font-size:1.5rem;margin-top:36px}.product-description__content img{height:auto;border-radius:var(--radius-card)}@media(max-width:749px){.product-description__grid{grid-template-columns:1fr;gap:25px}}{% endstylesheet %}
{% schema %}{"name":"t:sections.product_description.name","settings":[{"type":"text","id":"eyebrow","label":"t:labels.eyebrow","default":"The full story"},{"type":"text","id":"heading","label":"t:labels.heading","default":"Product details"}],"presets":[{"name":"t:sections.product_description.name"}]}{% endschema %}
