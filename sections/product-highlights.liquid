<section class="product-highlights section color-{{ section.settings.surface }}">
  <div class="page-width">
    <header class="product-section-head"><div class="eyebrow muted">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2>{% if section.settings.text != blank %}<p class="muted">{{ section.settings.text }}</p>{% endif %}</header>
    <div class="product-highlights__grid product-highlights__grid--{{ section.settings.columns }}">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><span class="product-highlights__number">{{ block.settings.kicker | default: forloop.index }}</span><h3>{{ block.settings.heading }}</h3><p class="muted">{{ block.settings.text }}</p></article>{% endfor %}</div>
  </div>
</section>
{% stylesheet %}
.product-section-head{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:end;margin-bottom:42px}.product-section-head h2{font-size:clamp(2.5rem,5vw,5.5rem);max-width:10ch;margin:12px 0 0}.product-section-head>p{max-width:48ch;margin:0}.product-highlights__grid{display:grid;border-top:1px solid var(--color-line)}.product-highlights__grid--3{grid-template-columns:repeat(3,1fr)}.product-highlights__grid--4{grid-template-columns:repeat(4,1fr)}.product-highlights article{padding:28px 28px 8px 0;border-right:1px solid var(--color-line);min-height:220px}.product-highlights article+article{padding-left:28px}.product-highlights article:last-child{border-right:0}.product-highlights__number{font-size:.72rem;color:var(--color-muted);letter-spacing:.12em}.product-highlights h3{font-size:1.45rem;margin:55px 0 12px}.product-highlights p{font-size:.9rem}@media(max-width:749px){.product-section-head{grid-template-columns:1fr;gap:15px}.product-highlights__grid--3,.product-highlights__grid--4{grid-template-columns:1fr 1fr}.product-highlights article{min-height:190px}.product-highlights article:nth-child(2n){border-right:0}.product-highlights article:nth-child(2n+1){padding-left:0}.product-highlights h3{margin-top:34px}}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.product_highlights.name","settings":[{"type":"text","id":"eyebrow","label":"t:labels.eyebrow","default":"Built into the frame"},{"type":"text","id":"heading","label":"t:labels.heading","default":"Everything you need. Nothing in your hands."},{"type":"textarea","id":"text","label":"t:labels.text","default":"The camera, audio and assistant work together without turning the frame into a gadget."},{"type":"select","id":"columns","label":"t:labels.columns","options":[{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"4"},{"type":"select","id":"surface","label":"t:labels.surface","options":[{"value":"canvas","label":"t:options.canvas"},{"value":"quiet","label":"t:options.quiet"}],"default":"canvas"}],"blocks":[{"type":"highlight","name":"t:sections.product_highlights.block","settings":[{"type":"text","id":"kicker","label":"t:labels.eyebrow","default":"01"},{"type":"text","id":"heading","label":"t:labels.heading","default":"8MP camera"},{"type":"textarea","id":"text","label":"t:labels.text","default":"Capture photos and video from your natural point of view."}]}],"max_blocks":8,"presets":[{"name":"t:sections.product_highlights.name","blocks":[{"type":"highlight"},{"type":"highlight","settings":{"kicker":"02","heading":"Open-ear audio","text":"Hear calls and music while staying aware of your surroundings."}},{"type":"highlight","settings":{"kicker":"03","heading":"Voice assistant","text":"Ask questions and control essentials without reaching for a phone."}},{"type":"highlight","settings":{"kicker":"04","heading":"Real-time translation","text":"Translate conversations through the companion app."}}]}]}
{% endschema %}
