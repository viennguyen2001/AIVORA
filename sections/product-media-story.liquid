<section class="product-media-story section">
  <div class="page-width product-media-story__grid{% if section.settings.layout == 'text_first' %} is-reversed{% endif %}">
    <div class="product-media-story__media">{% if section.settings.video %}{{ section.settings.video | video_tag: autoplay: section.settings.autoplay, loop: section.settings.autoplay, muted: section.settings.autoplay, controls: true, image_size: '1600x' }}{% elsif section.settings.image %}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600, 1800', sizes: '(max-width:749px) 100vw, 60vw', alt: section.settings.heading }}{% else %}<img src="{{ 'editorial-assistant.jpg' | asset_url }}" width="1200" height="1200" loading="lazy" alt="{{ section.settings.heading | escape }}">{% endif %}</div>
    <div class="product-media-story__copy"><div class="eyebrow muted">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2><div class="rte muted">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="text-link" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} &rarr;</a>{% endif %}</div>
  </div>
</section>
{% stylesheet %}
.product-media-story__grid{display:grid;grid-template-columns:1.2fr .8fr;gap:6%;align-items:center}.product-media-story__grid.is-reversed{grid-template-columns:.8fr 1.2fr}.product-media-story__grid.is-reversed .product-media-story__media{order:2}.product-media-story__media{aspect-ratio:4/3;border-radius:var(--radius-card);overflow:hidden;background:var(--color-surface)}.product-media-story__media img,.product-media-story__media video{width:100%;height:100%;object-fit:cover}.product-media-story__copy h2{font-size:clamp(2.6rem,4.7vw,5rem);max-width:10ch;margin:14px 0 24px}.product-media-story__copy .text-link{margin-top:28px}@media(max-width:749px){.product-media-story__grid,.product-media-story__grid.is-reversed{grid-template-columns:1fr;gap:28px}.product-media-story__grid.is-reversed .product-media-story__media{order:0}.product-media-story__copy h2{font-size:2.7rem}}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.product_media_story.name","settings":[{"type":"image_picker","id":"image","label":"t:labels.image"},{"type":"video","id":"video","label":"t:labels.video"},{"type":"checkbox","id":"autoplay","label":"t:labels.autoplay","default":false},{"type":"select","id":"layout","label":"t:labels.layout","options":[{"value":"media_first","label":"t:options.image_first"},{"value":"text_first","label":"t:options.text_first"}],"default":"media_first"},{"type":"text","id":"eyebrow","label":"t:labels.eyebrow","default":"Capture"},{"type":"text","id":"heading","label":"t:labels.heading","default":"Shot from where you were standing."},{"type":"richtext","id":"text","label":"t:labels.text","default":"<p>Record the moment from your own point of view without holding up a phone or mounting a camera.</p>"},{"type":"text","id":"button_label","label":"t:labels.button_label"},{"type":"url","id":"button_link","label":"t:labels.button_link"}],"presets":[{"name":"t:sections.product_media_story.name"}]}
{% endschema %}
