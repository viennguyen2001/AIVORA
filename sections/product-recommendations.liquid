<section class="product-recommendations section" data-product-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}">
  {% if recommendations.performed? and recommendations.products_count > 0 %}<div class="page-width"><div class="product-recommendations__head"><div><div class="eyebrow muted">{{ section.settings.eyebrow }}</div><h2 class="section-heading">{{ section.settings.heading }}</h2></div></div><div class="product-grid">{% for recommended_product in recommendations.products %}{% render 'product-card', product: recommended_product, show_vendor: section.settings.show_vendor %}{% endfor %}</div></div>{% endif %}
</section>
{% stylesheet %}.product-recommendations__head{margin-bottom:32px}.product-recommendations__head .eyebrow{margin-bottom:10px}{% endstylesheet %}
{% javascript %}
document.querySelectorAll('[data-product-recommendations]').forEach((root) => { const observer=new IntersectionObserver((entries)=>{if(!entries[0].isIntersecting)return;observer.disconnect();fetch(root.dataset.url).then(response=>response.text()).then(text=>{const html=new DOMParser().parseFromString(text,'text/html');const fresh=html.querySelector('[data-product-recommendations]');if(fresh?.innerHTML.trim())root.innerHTML=fresh.innerHTML}).catch(()=>{})},{rootMargin:'0px 0px 300px'});observer.observe(root); });
{% endjavascript %}
{% schema %}
{"name":"t:sections.product_recommendations.name","settings":[{"type":"text","id":"eyebrow","label":"t:labels.eyebrow","default":"Keep exploring"},{"type":"text","id":"heading","label":"t:labels.heading","default":"More in this range"},{"type":"select","id":"intent","label":"t:sections.product_recommendations.intent","options":[{"value":"related","label":"t:options.related"},{"value":"complementary","label":"t:options.complementary"}],"default":"related"},{"type":"range","id":"products_to_show","min":2,"max":8,"step":1,"label":"t:sections.featured_collection.products_to_show","default":4},{"type":"checkbox","id":"show_vendor","label":"t:sections.featured_collection.show_vendor","default":false}]}
{% endschema %}
