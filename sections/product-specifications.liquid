<section class="product-specs section" id="ProductSpecifications-{{ section.id }}">
  <div class="page-width product-specs__grid">
    <div class="product-specs__intro"><div class="eyebrow muted">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2><p class="muted">{{ section.settings.text }}</p>{% if section.settings.download_label != blank and section.settings.download_url != blank %}<a class="button button--secondary" href="{{ section.settings.download_url }}">{{ section.settings.download_label }}</a>{% endif %}</div>
    <div class="product-specs__table">{% assign current_group = '' %}{% for block in section.blocks %}{% if block.settings.group != blank and block.settings.group != current_group %}{% assign current_group = block.settings.group %}<h3>{{ current_group }}</h3>{% endif %}<div class="product-specs__row" {{ block.shopify_attributes }}><span>{{ block.settings.label }}</span><strong>{{ block.settings.value }}</strong></div>{% endfor %}</div>
  </div>
</section>
{% stylesheet %}
.product-specs{background:var(--color-ink);color:var(--color-canvas)}.product-specs .muted{color:color-mix(in srgb,var(--color-canvas) 65%,transparent)}.product-specs__grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:9%}.product-specs__intro{position:sticky;top:28px;align-self:start}.product-specs__intro h2{font-size:clamp(2.7rem,5vw,5.5rem);max-width:9ch;margin:14px 0 22px}.product-specs__intro p{max-width:38ch}.product-specs__intro .button{margin-top:20px;border-color:color-mix(in srgb,var(--color-canvas) 35%,transparent);color:var(--color-canvas)}.product-specs__table h3{font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--color-accent);margin:35px 0 8px}.product-specs__table h3:first-child{margin-top:0}.product-specs__row{display:grid;grid-template-columns:1fr 1fr;gap:20px;padding:17px 0;border-bottom:1px solid color-mix(in srgb,var(--color-canvas) 18%,transparent);font-size:.9rem}.product-specs__row span{color:color-mix(in srgb,var(--color-canvas) 65%,transparent)}@media(max-width:749px){.product-specs__grid{grid-template-columns:1fr;gap:38px}.product-specs__intro{position:static}.product-specs__row{grid-template-columns:.8fr 1.2fr}}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.product_specs.name","settings":[{"type":"text","id":"eyebrow","label":"t:labels.eyebrow","default":"Technical details"},{"type":"text","id":"heading","label":"t:labels.heading","default":"Full specifications"},{"type":"textarea","id":"text","label":"t:labels.text","default":"Every measurement and rating, in one place."},{"type":"text","id":"download_label","label":"t:sections.product_specs.download_label"},{"type":"url","id":"download_url","label":"t:sections.product_specs.download_url"}],"blocks":[{"type":"spec","name":"t:sections.product_specs.row","settings":[{"type":"text","id":"group","label":"t:sections.product_specs.group","default":"Camera"},{"type":"text","id":"label","label":"t:labels.label","default":"Resolution"},{"type":"text","id":"value","label":"t:labels.value","default":"8MP"}]}],"max_blocks":30,"presets":[{"name":"t:sections.product_specs.name","blocks":[{"type":"spec"},{"type":"spec","settings":{"group":"Camera","label":"Video","value":"1080p / 30fps"}},{"type":"spec","settings":{"group":"Audio","label":"Speakers","value":"Open-ear stereo"}},{"type":"spec","settings":{"group":"Battery","label":"Charging","value":"USB-C"}},{"type":"spec","settings":{"group":"Fit","label":"Frame weight","value":"35–41 g"}}]}]}
{% endschema %}
