<section class="product-testimonials section"><div class="page-width"><header class="product-testimonials__head"><div><div class="eyebrow muted">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2></div><div class="product-testimonials__summary"><strong>{{ section.settings.rating }}</strong><span aria-hidden="true">★★★★★</span><small class="muted">{{ section.settings.count_text }}</small></div></header><div class="product-testimonials__grid">{% for block in section.blocks %}<figure {{ block.shopify_attributes }}><div class="product-testimonials__stars" aria-hidden="true">★★★★★</div><blockquote>{{ block.settings.quote }}</blockquote><figcaption><strong>{{ block.settings.author }}</strong><span class="muted">{{ block.settings.detail }}</span></figcaption></figure>{% endfor %}</div></div></section>
{% stylesheet %}
.product-testimonials{background:var(--color-surface)}.product-testimonials__head{display:flex;justify-content:space-between;align-items:flex-end;gap:28px;margin-bottom:40px}.product-testimonials__head h2{font-size:clamp(2.6rem,5vw,5rem);margin:12px 0 0}.product-testimonials__summary{text-align:right}.product-testimonials__summary strong{display:block;font-size:2.4rem}.product-testimonials__summary>span,.product-testimonials__stars{color:var(--color-accent);letter-spacing:.1em}.product-testimonials__summary small{display:block}.product-testimonials__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.product-testimonials figure{margin:0;padding:26px;background:var(--color-canvas);border-radius:var(--radius-card)}.product-testimonials blockquote{margin:22px 0;font-size:1.1rem;line-height:1.5}.product-testimonials figcaption strong,.product-testimonials figcaption span{display:block}.product-testimonials figcaption span{font-size:.8rem;margin-top:3px}@media(max-width:749px){.product-testimonials__head{align-items:flex-start;flex-direction:column}.product-testimonials__summary{text-align:left}.product-testimonials__grid{display:flex;overflow-x:auto}.product-testimonials figure{flex:0 0 84%}}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.product_testimonials.name","settings":[{"type":"text","id":"eyebrow","label":"t:labels.eyebrow","default":"Verified buyers"},{"type":"text","id":"heading","label":"t:labels.heading","default":"Customers are saying"},{"type":"text","id":"rating","label":"t:labels.rating","default":"4.89"},{"type":"text","id":"count_text","label":"t:sections.product_testimonials.count_text","default":"Based on 602 reviews"}],"blocks":[{"type":"testimonial","name":"t:sections.product_testimonials.block","settings":[{"type":"textarea","id":"quote","label":"t:sections.product_testimonials.quote","default":"Light enough for every day, and the camera feels natural because it records exactly where I am looking."},{"type":"text","id":"author","label":"t:sections.product_testimonials.author","default":"Verified customer"},{"type":"text","id":"detail","label":"t:sections.product_testimonials.detail","default":"Purchased this product"}]}],"max_blocks":8,"presets":[{"name":"t:sections.product_testimonials.name","blocks":[{"type":"testimonial"},{"type":"testimonial"},{"type":"testimonial"}]}]}
{% endschema %}
