<section class="product-use-cases section"><div class="page-width"><header class="product-section-head"><div><div class="eyebrow muted">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2></div><p class="muted">{{ section.settings.text }}</p></header><div class="product-use-cases__grid">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><div class="product-use-cases__media">{% if block.settings.image %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '(max-width:749px) 84vw, 33vw', alt: block.settings.heading }}{% else %}{{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</div><div class="product-use-cases__body"><div class="eyebrow muted">{{ block.settings.eyebrow }}</div><h3>{{ block.settings.heading }}</h3><p class="muted">{{ block.settings.text }}</p></div></article>{% endfor %}</div></div></section>
{% stylesheet %}
.product-use-cases__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.product-use-cases article{background:var(--color-surface);border-radius:var(--radius-card);overflow:hidden}.product-use-cases__media{aspect-ratio:4/5;overflow:hidden}.product-use-cases__media img,.product-use-cases__media svg{width:100%;height:100%;object-fit:cover}.product-use-cases__body{padding:24px}.product-use-cases h3{font-size:1.6rem;margin:10px 0}.product-use-cases p{font-size:.9rem}@media(max-width:749px){.product-use-cases__grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;margin-inline:-16px;padding-inline:16px}.product-use-cases article{flex:0 0 84%;scroll-snap-align:start}}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.product_use_cases.name","settings":[{"type":"text","id":"eyebrow","label":"t:labels.eyebrow","default":"Made for real life"},{"type":"text","id":"heading","label":"t:labels.heading","default":"Where it earns its place"},{"type":"textarea","id":"text","label":"t:labels.text","default":"From the commute to the climb, capture without stepping out of the moment."}],"blocks":[{"type":"case","name":"t:sections.product_use_cases.block","settings":[{"type":"image_picker","id":"image","label":"t:labels.image"},{"type":"text","id":"eyebrow","label":"t:labels.eyebrow","default":"Everyday"},{"type":"text","id":"heading","label":"t:labels.heading","default":"Keep your phone away"},{"type":"textarea","id":"text","label":"t:labels.text","default":"Take calls, hear directions and capture a quick moment without stopping."}]}],"max_blocks":6,"presets":[{"name":"t:sections.product_use_cases.name","blocks":[{"type":"case"},{"type":"case","settings":{"eyebrow":"Travel","heading":"Understand more","text":"Use translation and quick answers while staying present."}},{"type":"case","settings":{"eyebrow":"Movement","heading":"Hands stay where they belong","text":"Record from eye level while you ride, run or explore."}}]}]}
{% endschema %}
