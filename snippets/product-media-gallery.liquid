{% doc %}
Renders the product media gallery with thumbnails and accessible controls.
@param {product} product - Product whose media should render.
@param {string} [media_fit] - contain or cover.
@param {boolean} [enable_zoom] - Enables click-to-zoom for images.
{% enddoc %}
<div class="product-media" data-product-media style="--media-fit:{{ media_fit | default: 'contain' }}">
  <div class="product-media__stage">
    {% for media in product.media %}
      <div class="product-media__item{% if media.id == product.selected_or_first_available_variant.featured_media.id or product.selected_or_first_available_variant.featured_media == blank and forloop.first %} is-active{% endif %}" data-media-id="{{ media.id }}" data-media-index="{{ forloop.index0 }}">
        {% case media.media_type %}
          {% when 'image' %}<button class="product-media__image{% if enable_zoom %} product-media__image--zoom{% endif %}" type="button" {% if enable_zoom %}data-media-zoom{% endif %} aria-label="{{ 'products.product.media.open_image' | t: index: forloop.index }}">{{ media | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1500, 1800', sizes: '(max-width: 989px) 100vw, 58vw', alt: media.alt }}</button>
          {% when 'video' %}{{ media | video_tag: controls: true, preload: 'metadata', image_size: '1200x' }}
          {% when 'external_video' %}{{ media | external_video_tag }}
          {% when 'model' %}{{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true }}
          {% else %}{{ media.preview_image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: media.alt }}
        {% endcase %}
      </div>
    {% else %}<div class="product-media__item is-active">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>{% endfor %}
    {% if product.media.size > 1 %}<div class="product-media__counter"><span data-media-current>1</span> / {{ product.media.size }}</div>{% endif %}
  </div>
  {% if product.media.size > 1 %}<div class="product-media__thumbs" aria-label="{{ 'products.product.media.gallery' | t }}">{% for media in product.media %}<button type="button" class="product-media__thumb{% if forloop.first %} is-active{% endif %}" data-media-thumb="{{ media.id }}" aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}">{{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: media.alt }}</button>{% endfor %}</div>{% endif %}
  <dialog class="product-media__dialog" data-media-dialog><button type="button" data-media-dialog-close aria-label="{{ 'accessibility.close' | t }}">&times;</button><img data-media-dialog-image width="1800" height="1800" alt=""></dialog>
</div>
